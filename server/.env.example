# Backend environment. Copy to server/.env and fill in real secrets for production.

# Port the API listens on (dev frontend proxies /api here)
PORT=4000

# Secret used to sign JWTs — CHANGE THIS in production (use a long random string)
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated allowed CORS origins for the browser app.
# In dev the Vite proxy means you usually don't need this; set it for production.
CORS_ORIGIN=http://localhost:5173

# ---- Admin account ---------------------------------------------------------
# In PRODUCTION (NODE_ENV=production) the app will NOT fall back to a known
# default — if ADMIN_PASSWORD is unset it generates a random one and warns.
# Always set a strong value for a deployed app. ADMIN_EMAIL is optional.
ADMIN_PASSWORD=admin123
# ADMIN_EMAIL=admin@loandr.app

# ---- Your personal loan-officer login --------------------------------------
# Seeded on first run so you always have a normal (non-admin) account, even when
# public signups are closed. Recommended for production.
# OWNER_EMAIL=you@yourcompany.com
# OWNER_PASSWORD=change-me
# OWNER_NAME=Your Name
# OWNER_COMPANY=Your Company

# ---- Access control --------------------------------------------------------
# ALLOW_SIGNUP=false closes public self-registration. To invite specific people
# without opening it to everyone, set SIGNUP_CODE and share the code — they
# enter it on the Create-account screen. (A set SIGNUP_CODE works even when
# ALLOW_SIGNUP=false.) Leave both unset in dev for open signups.
# ALLOW_SIGNUP=false
# SIGNUP_CODE=

# Seed a demo loan-officer account on first run (handy for local testing).
# Ignored in production unless explicitly set to true.
SEED_DEMO_USER=true
DEMO_EMAIL=demo@lender.com
DEMO_PASSWORD=demo1234

# Public base URL of the deployed app (used to build the Zapier webhook URL shown
# in the UI). Set this in production behind a TLS proxy, e.g. https://app.yourdomain.com
PUBLIC_BASE_URL=

# ---- ARIVE LOS integration -------------------------------------------------
# PRIMARY PATH (Arive has no public API): push loans in with Zapier.
#   Zap → Trigger: Arive (new/updated loan) · Action: "Webhooks by Zapier" (POST)
#   to the per-user webhook URL shown in the app (Pre-Approval → From your LOS).
# No env needed for the Zapier path.
#
# The vars below are only for a DIRECT REST API (left off by default):
# Leave ARIVE_API_TOKEN blank to use the built-in demo borrower data.
# To pull real borrowers: in ARIVE go to Settings → API Integrations, generate a
# token, and fill these in. Confirm the exact base URL + endpoint path/response
# shape against your ARIVE API docs (the defaults are best-effort).
ARIVE_API_BASE=
ARIVE_API_TOKEN=
ARIVE_AUTH_HEADER=Authorization
ARIVE_AUTH_SCHEME=Bearer
ARIVE_BORROWERS_PATH=/loans
ARIVE_SEARCH_PARAM=search
