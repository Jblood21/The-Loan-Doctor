# Frontend (Vite) environment.
# In development the app proxies /api to the backend, so VITE_API_BASE can stay empty.
# In production set it to your deployed API origin, e.g. https://api.yourdomain.com
VITE_API_BASE=

# Optional: override the dev proxy target (defaults to http://localhost:4000)
VITE_API_PROXY=http://localhost:4000
